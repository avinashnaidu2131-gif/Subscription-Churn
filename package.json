{
  "name": "churn-retry-middleware",
  "version": "1.0.0",
  "private": true,
  "description": "AI middleware mitigating credit card churn with algorithmic retry dunning",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "install:all": "npm --prefix frontend install",
    "backend": "uvicorn app.api.main:app --reload --port 8000",
    "test": "python -m unittest discover -s tests -p \"test_*.py\" -v"
  }
}

